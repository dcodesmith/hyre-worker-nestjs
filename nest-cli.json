{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "typeCheck": false,
    "builder": {
      "type": "swc",
      "options": {
        "extensions": [".js", ".ts", ".tsx"],
        "ignore": ["**/*.spec.ts", "**/email-previews/**"]
      }
    },
    "assets": [
      { "include": "**/*.hbs", "outDir": "dist" },
      { "include": "**/*.mjml", "outDir": "dist" },
      { "include": "**/*.html", "outDir": "dist" },
      { "include": "**/*.sql", "outDir": "dist" }
    ],
    "watchAssets": true
  }
}
